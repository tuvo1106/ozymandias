{
  "_comment": [
    "Hop A contract (docs/wire-protocol.md §A): what each SDK call must put on the wire.",
    "Loaded by pkg/wire's Go tests (every expect line must parse back to the call) and by both SDK test suites.",
    "init: the arguments to init() (service, env, version, tags). call + metric/value/tags/sample_rate: the statsd method and its arguments.",
    "value defaults to 1 for increment/decrement. value_special replaces value with nan, inf or -inf, which JSON can't express.",
    "random: the value the SDK's injected random source returns for the sampling decision (sent when random < sample_rate).",
    "expect: the exact datagram line, or null when nothing may be sent.",
    "The canonical form cases exist because String() in JS and repr() in Python disagree outside [1e-4, 1e16); they are the windows where this file is the only thing keeping the two SDKs writing the same bytes."
  ],
  "cases": [
    {
      "name": "increment with the default value",
      "init": {},
      "call": "increment",
      "metric": "page.views",
      "expect": "page.views:1|c"
    },
    {
      "name": "increment by a value, with tags",
      "init": {},
      "call": "increment",
      "metric": "page.views",
      "value": 3,
      "tags": [
        "route:/api/comics",
        "method:get"
      ],
      "expect": "page.views:3|c|#route:/api/comics,method:get"
    },
    {
      "name": "decrement with the default value",
      "init": {},
      "call": "decrement",
      "metric": "jobs.active",
      "expect": "jobs.active:-1|c"
    },
    {
      "name": "decrement by a value",
      "init": {},
      "call": "decrement",
      "metric": "jobs.active",
      "value": 2,
      "expect": "jobs.active:-2|c"
    },
    {
      "name": "gauge, integral value",
      "init": {},
      "call": "gauge",
      "metric": "arq.queue.depth",
      "value": 3,
      "expect": "arq.queue.depth:3|g"
    },
    {
      "name": "gauge, integral float prints without a decimal point",
      "init": {},
      "call": "gauge",
      "metric": "arq.queue.depth",
      "value": 1.0,
      "expect": "arq.queue.depth:1|g"
    },
    {
      "name": "gauge, fraction",
      "init": {},
      "call": "gauge",
      "metric": "cache.hit_ratio",
      "value": 0.25,
      "expect": "cache.hit_ratio:0.25|g"
    },
    {
      "name": "gauge, negative",
      "init": {},
      "call": "gauge",
      "metric": "temp.delta",
      "value": -1.5,
      "expect": "temp.delta:-1.5|g"
    },
    {
      "name": "gauge, shortest round-trip repr",
      "init": {},
      "call": "gauge",
      "metric": "float.check",
      "value": 0.30000000000000004,
      "expect": "float.check:0.30000000000000004|g"
    },
    {
      "name": "canonical form: positional right below the exponent threshold",
      "init": {},
      "call": "gauge",
      "metric": "float.check",
      "value": 1000000000000000.0,
      "expect": "float.check:1000000000000000|g"
    },
    {
      "name": "canonical form: exponent at 1e16, where the threshold is",
      "init": {},
      "call": "gauge",
      "metric": "float.check",
      "value": 1e+16,
      "expect": "float.check:1e+16|g"
    },
    {
      "name": "canonical form: a realistic large integer stays positional",
      "init": {},
      "call": "gauge",
      "metric": "mem.rss",
      "value": 1048576,
      "expect": "mem.rss:1048576|g"
    },
    {
      "name": "canonical form: positional down to 1e-4",
      "init": {},
      "call": "gauge",
      "metric": "cache.hit_ratio",
      "value": 0.0001,
      "expect": "cache.hit_ratio:0.0001|g"
    },
    {
      "name": "canonical form: exponent below 1e-4, padded to two digits",
      "init": {},
      "call": "gauge",
      "metric": "cache.hit_ratio",
      "value": 1e-05,
      "expect": "cache.hit_ratio:1e-05|g"
    },
    {
      "name": "canonical form: a two-digit exponent is not trimmed",
      "init": {},
      "call": "gauge",
      "metric": "cache.hit_ratio",
      "value": 1e-07,
      "expect": "cache.hit_ratio:1e-07|g"
    },
    {
      "name": "canonical form: the smallest subnormal",
      "init": {},
      "call": "gauge",
      "metric": "float.check",
      "value": 5e-324,
      "expect": "float.check:5e-324|g"
    },
    {
      "name": "histogram",
      "init": {},
      "call": "histogram",
      "metric": "payload.bytes",
      "value": 512,
      "expect": "payload.bytes:512|h"
    },
    {
      "name": "distribution",
      "init": {},
      "call": "distribution",
      "metric": "http.request.duration",
      "value": 12.4,
      "tags": [
        "route:/api/comics"
      ],
      "expect": "http.request.duration:12.4|d|#route:/api/comics"
    },
    {
      "name": "timing, milliseconds",
      "init": {},
      "call": "timing",
      "metric": "judge.run.duration",
      "value": 250,
      "expect": "judge.run.duration:250|ms"
    },
    {
      "name": "set, string member",
      "init": {},
      "call": "set",
      "metric": "users.unique",
      "value": "user_91",
      "expect": "users.unique:user_91|s"
    },
    {
      "name": "set, numeric member is sent as its string form",
      "init": {},
      "call": "set",
      "metric": "users.unique",
      "value": 42,
      "expect": "users.unique:42|s"
    },
    {
      "name": "sample rate below 1, sampled in",
      "init": {},
      "call": "increment",
      "metric": "page.views",
      "sample_rate": 0.5,
      "random": 0.25,
      "expect": "page.views:1|c|@0.5"
    },
    {
      "name": "sample rate below 1, sampled out",
      "init": {},
      "call": "increment",
      "metric": "page.views",
      "sample_rate": 0.5,
      "random": 0.75,
      "expect": null
    },
    {
      "name": "sample rate 1 is not written",
      "init": {},
      "call": "increment",
      "metric": "page.views",
      "sample_rate": 1,
      "expect": "page.views:1|c"
    },
    {
      "name": "sample rate and tags: rate comes first",
      "init": {},
      "call": "histogram",
      "metric": "payload.bytes",
      "value": 7,
      "sample_rate": 0.1,
      "random": 0.05,
      "tags": [
        "a:b"
      ],
      "expect": "payload.bytes:7|h|@0.1|#a:b"
    },
    {
      "name": "global tags follow call tags: init tags, then service, env, version",
      "init": {
        "service": "shop",
        "env": "dev",
        "version": "1.2.0",
        "tags": [
          "team:core"
        ]
      },
      "call": "increment",
      "metric": "page.views",
      "tags": [
        "route:/"
      ],
      "expect": "page.views:1|c|#route:/,team:core,service:shop,env:dev,version:1.2.0"
    },
    {
      "name": "global tags with no call tags",
      "init": {
        "service": "shop",
        "env": "dev",
        "version": "1.2.0",
        "tags": [
          "team:core"
        ]
      },
      "call": "gauge",
      "metric": "arq.queue.depth",
      "value": 3,
      "expect": "arq.queue.depth:3|g|#team:core,service:shop,env:dev,version:1.2.0"
    },
    {
      "name": "only the global tags that are set",
      "init": {
        "service": "shop"
      },
      "call": "increment",
      "metric": "page.views",
      "expect": "page.views:1|c|#service:shop"
    },
    {
      "name": "sanitation: '|', ':', ',' and newline in a name become '_'",
      "init": {},
      "call": "increment",
      "metric": "bad|name:x,y\nz",
      "expect": "bad_name_x_y_z:1|c"
    },
    {
      "name": "sanitation: '|', ',' and newline in a tag become '_' (':' is kept)",
      "init": {},
      "call": "increment",
      "metric": "page.views",
      "tags": [
        "k:v,w|z\nq"
      ],
      "expect": "page.views:1|c|#k:v_w_z_q"
    },
    {
      "name": "sanitation: '|', ',' and newline in a set member become '_'",
      "init": {},
      "call": "set",
      "metric": "users.unique",
      "value": "a|b,c\nd",
      "expect": "users.unique:a_b_c_d|s"
    },
    {
      "name": "NaN is dropped, not sent",
      "init": {},
      "call": "gauge",
      "metric": "bad.value",
      "value_special": "nan",
      "expect": null
    },
    {
      "name": "infinity is dropped, not sent",
      "init": {},
      "call": "gauge",
      "metric": "bad.value",
      "value_special": "inf",
      "expect": null
    },
    {
      "name": "negative infinity is dropped, not sent",
      "init": {},
      "call": "gauge",
      "metric": "bad.value",
      "value_special": "-inf",
      "expect": null
    }
  ]
}
