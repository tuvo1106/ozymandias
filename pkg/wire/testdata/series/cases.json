{
  "_comment": [
    "Hop C validation (docs/wire-protocol.md §C). Each case is one series; tests send them together in one payload and",
    "check that exactly the invalid ones are rejected, each for the reason whose text contains `reject` (null = accepted).",
    "Timestamps are relative to now = 1790000000."
  ],
  "now": 1790000000,
  "cases": [
    {"name": "the example from the spec (names generic)", "reject": null,
     "series": {"metric": "http.request.count", "type": "count", "interval": 10,
                "tags": ["env:dev", "host:web-1", "route:/api/comics", "service:shop"],
                "points": [[1789999990, 42.0], [1790000000, 17.0]]}},
    {"name": "gauge with interval 0", "reject": null,
     "series": {"metric": "arq.queue.depth", "type": "gauge", "interval": 0, "tags": [], "points": [[1790000000, 3]]}},
    {"name": "rate with a positive interval", "reject": null,
     "series": {"metric": "net.bytes_rcvd", "type": "rate", "interval": 10, "tags": ["host:a"], "points": [[1790000000, 1.5]]}},
    {"name": "bare tag and a value with colons", "reject": null,
     "series": {"metric": "a.b", "type": "gauge", "interval": 0, "tags": ["canary", "url:http://x:8080/y"], "points": [[1790000000, 1]]}},
    {"name": "unknown fields are ignored", "reject": null,
     "series": {"metric": "a.b", "type": "gauge", "interval": 0, "tags": [], "points": [[1790000000, 1]], "unit": "ms"}},
    {"name": "10 minutes ahead is still accepted", "reject": null,
     "series": {"metric": "a.b", "type": "gauge", "interval": 0, "tags": [], "points": [[1790000600, 1]]}},

    {"name": "metric starting with a digit", "reject": "invalid metric name",
     "series": {"metric": "1bad", "type": "gauge", "interval": 0, "tags": [], "points": [[1790000000, 1]]}},
    {"name": "metric with a dash", "reject": "invalid metric name",
     "series": {"metric": "bad-name", "type": "gauge", "interval": 0, "tags": [], "points": [[1790000000, 1]]}},
    {"name": "unknown type", "reject": "unknown type",
     "series": {"metric": "a.b", "type": "histogram", "interval": 0, "tags": [], "points": [[1790000000, 1]]}},
    {"name": "count without an interval", "reject": "positive interval",
     "series": {"metric": "a.b", "type": "count", "interval": 0, "tags": [], "points": [[1790000000, 1]]}},
    {"name": "gauge with an interval", "reject": "interval 0",
     "series": {"metric": "a.b", "type": "gauge", "interval": 10, "tags": [], "points": [[1790000000, 1]]}},
    {"name": "tag key starting with a digit", "reject": "invalid tag",
     "series": {"metric": "a.b", "type": "gauge", "interval": 0, "tags": ["1env:dev"], "points": [[1790000000, 1]]}},
    {"name": "upper-case tag key", "reject": "invalid tag",
     "series": {"metric": "a.b", "type": "gauge", "interval": 0, "tags": ["Env:dev"], "points": [[1790000000, 1]]}},
    {"name": "tag with a comma", "reject": "invalid tag",
     "series": {"metric": "a.b", "type": "gauge", "interval": 0, "tags": ["env:dev,prod"], "points": [[1790000000, 1]]}},
    {"name": "no points", "reject": "no points",
     "series": {"metric": "a.b", "type": "gauge", "interval": 0, "tags": [], "points": []}},
    {"name": "more than 10 minutes in the future", "reject": "in the future",
     "series": {"metric": "a.b", "type": "gauge", "interval": 0, "tags": [], "points": [[1790000601, 1]]}},
    {"name": "fractional timestamp", "reject": "integer unix seconds",
     "series": {"metric": "a.b", "type": "gauge", "interval": 0, "tags": [], "points": [[1790000000.5, 1]]}},
    {"name": "value overflowing float64", "reject": "out of range",
     "series": {"metric": "a.b", "type": "gauge", "interval": 0, "tags": [], "points": [[1790000000, 1e400]]}},
    {"name": "point that is not a pair", "reject": "got 3 elements",
     "series": {"metric": "a.b", "type": "gauge", "interval": 0, "tags": [], "points": [[1790000000, 1, 2]]}},
    {"name": "tags is not an array", "reject": "cannot unmarshal",
     "series": {"metric": "a.b", "type": "gauge", "interval": 0, "tags": "env:dev", "points": [[1790000000, 1]]}}
  ]
}
