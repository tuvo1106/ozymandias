# Copy to .env (gitignored) for local overrides. Nothing here is a secret;
# real secrets (notifier webhooks, API keys from M7) are only ever read from
# the environment and never committed.

# --- ozyd (server) — every key in deploy/ozyd.yaml can be
# overridden with OZY_<SECTION>_<KEY>; see docs/operations.md.
# OZY_HTTP_ADDR=:9400
# OZY_DATA_DIR=./data/ozyd
# OZY_LOG_LEVEL=info

# --- agent — overrides use OZY_AGENT_<SECTION>_<KEY>.
# OZY_AGENT_HTTP_ADDR=:8126
# OZY_AGENT_INTAKE_URL=http://localhost:9400
# OZY_AGENT_CONFD_PATH=./deploy/agent.d
# OZY_AGENT_LOG_LEVEL=info

# --- make sdk-release (from M1): where to copy built SDK artifacts.
# Space-separated directories; the script itself names no app.
# SDK_PYTHON_TARGETS=../app-python/backend/vendor
# SDK_NODE_TARGETS=../app-node/vendor
